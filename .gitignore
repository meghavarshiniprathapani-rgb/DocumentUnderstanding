# ==============================================================================
# Retrieva AI — Comprehensive .gitignore
# ==============================================================================

# Python Bytecode & Compilation Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Quality & Coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.ruff_cache/
.tox/
.nox/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Node.js & Web Bundler Artifacts
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# User Uploads Directory
data/uploads/*
!data/uploads/.gitkeep

# Evaluation Generated Reports (keep .gitkeep in data/)
data/benchmarks/*.json
eval_report_*.json

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
